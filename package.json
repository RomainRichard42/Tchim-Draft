{
  "name": "tchim-draft",
  "version": "0.10.0",
  "description": "Assistant de draft League of Legends desktop, local et explicable",
  "author": "Tchim",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "collect": "node dist/collector/index.cjs",
    "scrape": "node dist/collector/scrape.cjs",
    "rebuild": "node scripts/rebuild.mjs",
    "dist:win": "npm run build && node scripts/package.mjs win",
    "dist:mac": "npm run build && node scripts/package.mjs mac",
    "postinstall": "node scripts/rebuild.mjs",
    "data:export": "node dist/collector/export-dataset.cjs",
    "publish:data": "npm run build && npm run data:export && node scripts/publish-data.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "sprintf-js": "^1.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RomainRichard42/Tchim-Draft.git"
  }
}
